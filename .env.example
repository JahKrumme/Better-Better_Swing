# Choose a local password; use the same password in DATABASE_URL.
LOCAL_DB_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://finder:replace-with-local-password@127.0.0.1:5432/free_money_finder
# Optional known age in years. Blank means Needs Verification for age.
PROFILE_AGE=
PROFILE_STATE=KS
PROFILE_COUNTRY=US
# Optional ports. Blank values choose an available local port.
APP_PORT=
LOCAL_DB_PORT=
# Local schedules refresh every 5 minutes (allowed 60–3600 seconds).
OPERATIONS_INTERVAL_SECONDS=300
# Set true only when DATABASE_URL points to your own existing app database.
USE_EXISTING_DATABASE=false
